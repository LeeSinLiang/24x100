# Copy to .env and fill in. .env is gitignored; never commit keys.
# Default extraction provider (Google AI Studio, free tier):
GOOGLE_API_KEY=
# Optional drop-in alternative for extraction and the side-by-side eval:
ANTHROPIC_API_KEY=
# EXTRACT_PROVIDER=gemini   # gemini | anthropic
# EXTRACT_MODEL=            # defaults are recorded in docs/decisions.md
# Watchlist digest (off by default; only used with `npm run digest -- --send`):
SLACK_WEBHOOK_URL=
# Email through Resend (resend.com → API Keys → Create, sending access). With the default sender
# (onboarding@resend.dev) Resend delivers only to the address that owns the account: DIGEST_TO must be that address.
RESEND_API_KEY=
DIGEST_TO=
# DIGEST_FROM=24×100 <onboarding@resend.dev>   # another sender needs a domain verified with Resend
# SMTP instead of Resend (used only when RESEND_API_KEY is empty):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
